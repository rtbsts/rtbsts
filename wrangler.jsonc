// Cloudflare Workers configuration: publishes the static site built by build.py.
{
  "name": "rtbsts",
  "compatibility_date": "2025-09-01",
  // Runs before every deploy: builds the site into dist/
  "build": {
    "command": "pip install -r requirements.txt && python3 build.py"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
